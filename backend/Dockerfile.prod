FROM ruby:3.3.6-alpine AS builder

# Install dependencies
RUN apk add --no-cache \
    build-base \
    postgresql-dev \
    tzdata \
    git \
    nodejs \
    npm

WORKDIR /app

# Install bundler
RUN gem install bundler:2.5.23

# Copy Gemfile
COPY Gemfile Gemfile.lock ./

# Install production gems only
RUN bundle config set --local deployment 'true' && \
    bundle config set --local without 'development test' && \
    bundle install -j4

# Copy application code
COPY . .

# Precompile assets (if any)
RUN bundle exec rails assets:precompile || true

# Runtime stage
FROM ruby:3.3.6-alpine

RUN apk add --no-cache \
    postgresql-client \
    tzdata \
    bash \
    curl

WORKDIR /app

# Install bundler
RUN gem install bundler:2.5.23

# Copy installed gems from builder
COPY --from=builder /usr/local/bundle /usr/local/bundle

# Copy application code
COPY --from=builder /app /app

# Create non-root user
RUN addgroup -g 1000 rails && \
    adduser -D -u 1000 -G rails rails && \
    chown -R rails:rails /app

USER rails

EXPOSE 3001

# Start server
CMD ["rails", "server", "-b", "0.0.0.0", "-p", "3001", "-e", "production"]
